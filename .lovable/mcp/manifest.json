{
  "version": 1,
  "sdk_version": "0.25.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://cuqpkrludheosxvsjqmj.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "sweet-rewards-launch",
      "version": "0.1.0",
      "title": "Sweet Rewards Launch"
    },
    "tools": [
      {
        "name": "signup_summary",
        "title": "Signup summary",
        "description": "Summarise total signups, redeemed signups and reward popularity for the Sans Sucre launch campaign.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_signups",
        "title": "List signups",
        "description": "List the most recent Sans Sucre reward signups, optionally filtered by redemption status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "How many signups to return (1-100). Defaults to 20."
            },
            "status": {
              "type": "string",
              "enum": [
                "all",
                "redeemed",
                "unredeemed"
              ],
              "description": "Filter by redemption status. Defaults to all."
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "lookup_redemption_code",
        "title": "Look up a redemption code",
        "description": "Look up a single Sans Sucre signup by its redemption code and report its reward and redemption state.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "description": "The 12-character redemption code shown on the guest's receipt."
            }
          },
          "required": [
            "code"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_testimonials",
        "title": "List testimonials",
        "description": "List guest testimonials with their rating, quote and approval state.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "How many testimonials to return (1-100). Defaults to 20."
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
